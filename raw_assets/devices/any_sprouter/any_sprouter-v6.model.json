      {"shape": "group", "name": "fault lamp", "atM": [0.941, 0, 0.700], "parts": [
        {"shape": "cylinder", "name": "bezel", "atM": [0, 0.089, 0], "radiusM": 0.021, "lengthM": 0.006, "axis": "y", "tex": "trim"},
        {"shape": "sphere", "name": "lens", "atM": [0, 0.086, 0], "sizeM": [0.032, 0.032, 0.012], "half": true,
